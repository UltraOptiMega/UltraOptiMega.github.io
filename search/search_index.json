bcd\u672c","text":"<p>\u5907\u8003\u82f1\u8bed\u65f6\uff0c\u4f60\u6709\u6ca1\u6709\u9047\u5230\u8fc7\u8fd9\u4e9b\u95ee\u9898\uff1f</p> <ul> <li>\u7eb8\u8d28\u8bcd\u4e66\u4e0a\u505a\u4e86\u4e00\u5806\u6807\u6ce8\uff0c\u4f46\u788e\u7247\u65f6\u95f4\u6ca1\u6cd5\u62ff\u51fa\u6765\u590d\u4e60</li> <li>\u5e02\u9762\u4e0a\u7684\u80cc\u5355\u8bcd APP \u8bcd\u5e93\u592a\u5168\uff0c80% \u7684\u8bcd\u4f60\u90fd\u8ba4\u8bc6\uff0c\u80cc\u4e86\u6d6a\u8d39\u65f6\u95f4</li> <li>\u624b\u52a8\u628a\u4e66\u4e0a\u4e0d\u4f1a\u7684\u8bcd\u4e00\u4e2a\u4e2a\u5f55\u5165\u624b\u673a\uff0c\u592a\u6162\u592a\u9ebb\u70e6</li> </ul> <p>\u6d77\u72ee\u5355\u8bcd\u751f\u8bcd\u672c\u5fae\u4fe1\u5c0f\u7a0b\u5e8f\uff0c\u5e2e\u4f60\u89e3\u51b3\u8fd9\u4e9b\u95ee\u9898\uff1a\u62cd\u4e00\u5f20\u7eb8\u8d28\u8bcd\u6c47\u8868\u7684\u7167\u7247\uff0cAI \u81ea\u52a8\u8bc6\u522b\u5355\u8bcd\u3001\u97f3\u6807\u548c\u91ca\u4e49\uff0c\u751f\u6210\u4f60\u7684\u4e13\u5c5e\u7535\u5b50\u5355\u8bcd\u672c\u3002</p> <p></p>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_2","title":"\u6838\u5fc3\u529f\u80fd","text":"","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_3","title":"\u62cd\u7167\u8bc6\u522b\u5355\u8bcd","text":"<p>\u5bf9\u51c6\u7eb8\u8d28\u8bcd\u6c47\u8868\u62cd\u4e00\u5f20\u7167\uff0c\u5c0f\u7a0b\u5e8f\u81ea\u52a8\u63d0\u53d6\u6bcf\u4e2a\u5355\u8bcd\u7684\uff1a</p> <ul> <li>\u82f1\u6587\u5355\u8bcd\u6216\u8bcd\u7ec4\uff08\u652f\u6301 look forward to \u8fd9\u7c7b\u8bcd\u7ec4\uff09</li> <li>\u82f1\u5f0f\u97f3\u6807\u548c\u7f8e\u5f0f\u97f3\u6807</li> <li>\u4e2d\u6587\u91ca\u4e49</li> </ul> <p>\u8bc6\u522b\u7ed3\u679c\u76f4\u63a5\u5b58\u5165\u5355\u8bcd\u672c\uff0c\u968f\u65f6\u53ef\u4ee5\u6253\u5f00\u590d\u4e60\u3002</p>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_4","title":"\u624b\u5199\u6807\u8bb0\u8fc7\u6ee4\uff08\u7279\u8272\u529f\u80fd\uff09","text":"<p>\u8fd9\u662f\u6700\u5b9e\u7528\u7684\u529f\u80fd\u3002</p> <p>\u4f60\u5728\u7eb8\u8d28\u8bcd\u4e66\u4e0a\u7528\u7b14\u52fe\u51fa\u4e0d\u8ba4\u8bc6\u6216\u9700\u8981\u91cd\u70b9\u80cc\u7684\u8bcd\u2014\u2014\u6253\u52fe\u3001\u753b\u5708\u3001\u8367\u5149\u7b14\u6807\u8bb0\u90fd\u884c\u3002\u62cd\u7167\u65f6\u9009\u62e9\u300c\u6807\u8bb0\u6a21\u5f0f\u300d\uff0cAI \u4f1a\u8bc6\u522b\u54ea\u4e9b\u8bcd\u6709\u6807\u8bb0\uff0c\u53ea\u63d0\u53d6\u8fd9\u4e9b\u8bcd\u3002</p> <p>\u8fd9\u610f\u5473\u7740\uff1a</p> <ul> <li>\u8001\u5e08\u5212\u7684\u91cd\u70b9\u8bcd\uff0c\u62cd\u4e00\u4e0b\u5c31\u6574\u7406\u597d\u4e86</li> <li>\u81ea\u5df1\u6807\u6ce8\u7684\u9519\u8bcd\uff0c\u4e0d\u7528\u624b\u52a8\u5f55\u5165</li> <li>\u8bd5\u5377\u4e0a\u4e0d\u4f1a\u7684\u751f\u8bcd\uff0c\u4e00\u626b\u5373\u5b58</li> </ul>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_5","title":"\u5355\u8bcd\u7ba1\u7406","text":"<ul> <li>\u65b0\u8bcd\u548c\u5df2\u638c\u63e1\u4e24\u79cd\u72b6\u6001</li> <li>\u6807\u8bb0\u4e3a\u300c\u5df2\u638c\u63e1\u300d\u540e\u81ea\u52a8\u4ece\u751f\u8bcd\u5217\u8868\u79fb\u9664</li> <li>\u652f\u6301\u5220\u9664\u4e0d\u9700\u8981\u7684\u8bcd</li> <li>\u6309\u6dfb\u52a0\u65f6\u95f4\u6392\u5e8f\uff0c\u6700\u65b0\u5f55\u5165\u7684\u8bcd\u5728\u6700\u524d\u9762</li> </ul>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_6","title":"\u97f3\u6807\u663e\u793a","text":"<p>\u81ea\u52a8\u8bc6\u522b\u82f1\u5f0f\u548c\u7f8e\u5f0f\u97f3\u6807\uff0c\u5982\u679c\u7eb8\u8d28\u4e66\u4e0a\u6709\u97f3\u6807\u4f1a\u76f4\u63a5\u63d0\u53d6\uff0c\u6ca1\u6709\u7684\u8bdd\u4e5f\u4e0d\u4f1a\u4e71\u586b\u3002\u97f3\u6807\u683c\u5f0f\u89c4\u8303\uff0c\u4e0d\u4f1a\u51fa\u73b0 <code>[[]]</code> \u8fd9\u79cd\u91cd\u590d\u62ec\u53f7\u3002</p>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_7","title":"\u9002\u5408\u8c01\u7528","text":"<p>\u96c5\u601d/\u6258\u798f\u8003\u751f</p> <p>\u542c\u529b\u8bcd\u4e66\uff08\u5982\u96c5\u601d\u738b\u542c\u529b\u3001538 \u8003\u70b9\u8bcd\u771f\u7ecf\uff09\u4e0a\u6807\u6ce8\u7684\u751f\u8bcd\uff0c\u62cd\u7167\u76f4\u63a5\u5f55\u5165\u3002\u505a\u5b8c\u542c\u529b\u771f\u9898\u540e\uff0c\u628a\u4e0d\u8ba4\u8bc6\u7684\u8bcd\u5728\u4e66\u4e0a\u6807\u8bb0\uff0c\u62cd\u4e00\u5f20\u5c31\u6574\u7406\u597d\u4e86\u3002</p> <p>\u56db\u516d\u7ea7\u8003\u751f</p> <p>\u8bfe\u672c\u8bcd\u6c47\u8868\u6279\u91cf\u5bfc\u5165\uff0c\u4e0d\u7528\u624b\u52a8\u4e00\u4e2a\u4e2a\u8f93\u5165\u3002\u590d\u4e60\u65f6\u53ea\u770b\u81ea\u5df1\u4e0d\u4f1a\u7684\u8bcd\uff0c\u6548\u7387\u7ffb\u500d\u3002</p> <p>\u521d\u9ad8\u4e2d\u5b66\u751f</p> <p>\u8bfe\u672c\u4e0a\u7684\u91cd\u70b9\u5355\u8bcd\u3001\u8001\u5e08\u5212\u7684\u5fc5\u80cc\u8bcd\uff0c\u62cd\u7167\u5c31\u80fd\u751f\u6210\u4e2a\u4eba\u5355\u8bcd\u672c\u3002\u5bb6\u957f\u53ef\u4ee5\u5e2e\u5b69\u5b50\u6574\u7406\u9519\u9898\u672c\u91cc\u7684\u751f\u8bcd\u3002</p> <p>\u82f1\u8bed\u81ea\u5b66\u8005</p> <p>\u9605\u8bfb\u82f1\u6587\u539f\u7248\u4e66\u6216\u6587\u7ae0\u65f6\u9047\u5230\u7684\u751f\u8bcd\uff0c\u968f\u624b\u8bb0\u5728\u4e66\u4e0a\uff0c\u5b9a\u671f\u62cd\u7167\u6574\u7406\u5230\u5355\u8bcd\u672c\u91cc\u3002</p>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_8","title":"\u4f7f\u7528\u573a\u666f\u793a\u4f8b","text":"","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_9","title":"\u573a\u666f\u4e00\uff1a\u96c5\u601d\u542c\u529b\u5907\u8003","text":"<ol> <li>\u7528\u300a\u96c5\u601d\u738b\u542c\u529b\u300b\u505a\u542c\u529b\u7ec3\u4e60</li> <li>\u9047\u5230\u4e0d\u8ba4\u8bc6\u7684\u8bcd\uff0c\u5728\u4e66\u4e0a\u6253\u4e2a \u2713</li> <li>\u505a\u5b8c\u540e\u6253\u5f00\u5c0f\u7a0b\u5e8f\uff0c\u9009\u62e9\u300c\u6807\u8bb0\u6a21\u5f0f\u300d\u62cd\u7167</li> <li>\u53ea\u63d0\u53d6\u6253\u52fe\u7684\u8bcd\uff0c\u751f\u6210\u4f60\u7684\u542c\u529b\u9519\u8bcd\u672c</li> <li>\u788e\u7247\u65f6\u95f4\u6253\u5f00\u590d\u4e60</li> </ol>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_10","title":"\u573a\u666f\u4e8c\uff1a\u8bfe\u672c\u8bcd\u6c47\u6574\u7406","text":"<ol> <li>\u7ffb\u5f00\u82f1\u8bed\u8bfe\u672c\u7684\u8bcd\u6c47\u8868\u9875</li> <li>\u9009\u62e9\u300c\u666e\u901a\u6a21\u5f0f\u300d\u62cd\u7167</li> <li>\u6574\u9875\u8bcd\u6c47\u81ea\u52a8\u5f55\u5165</li> <li>\u628a\u5df2\u638c\u63e1\u7684\u8bcd\u6807\u8bb0\u4e3a\u300c\u5df2\u638c\u63e1\u300d</li> <li>\u53ea\u5269\u4e0d\u4f1a\u7684\u8bcd\u9700\u8981\u91cd\u70b9\u80cc</li> </ol>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u798f","\u56db\u516d\u7ea7"]},{"location":"posts/sealion-ocr/#_11","title":"\u573a\u666f\u4e09\uff1a\u8bd5\u5377\u9519\u9898\u6574\u7406","text":"<ol> <li>\u505a\u5b8c\u82f1\u8bed\u8bd5\u5377\uff0c\u5728\u8bd5\u5377\u4e0a\u6807\u51fa\u751f\u8bcd</li> <li>\u62cd\u7167\u8bc6\u522b\uff0c\u5f55\u5165\u5355\u8bcd\u672c</li> <li>\u6bcf\u6b21\u8003\u524d\u6253\u5f00\u590d\u4e60\u81ea\u5df1\u7684\u4e13\u5c5e\u9519\u8bcd</li> </ol>","tags":["\u5c0f\u7a0b\u5e8f","\u82f1\u8bed\u5b66\u4e60","OCR","\u5de5\u5177\u5206\u4eab","\u96c5\u601d","\u6258\u7